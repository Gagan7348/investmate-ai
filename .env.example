# InvestMate AI - Environment Variables
# Copy this file to .env and fill in your actual keys.
# NEVER commit .env to version control.

# === Groq LLM API ===
GROQ_API_KEY=gsk_your_groq_api_key_here

# === ElevenLabs Voice API (Optional) ===
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# === Application Settings ===
# LLM model to use (Groq-hosted models)
LLM_MODEL=llama-3.1-70b-versatile

# Base currency
BASE_CURRENCY=INR

# Demo mode: set to "true" to use sample data without API calls
DEMO_MODE=false

# Database path (relative to project root)
DATABASE_PATH=investmate.db

# Max tool calls per agent request
MAX_TOOL_CALLS=5

# Voice output enabled
VOICE_ENABLED=true

# Log level
LOG_LEVEL=INFO
